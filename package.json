{
  "name": "doop",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "bun run build:claude-extension && concurrently -n server,web -c yellow,cyan \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite\"",
    "build": "bun run build:claude-extension && vite build",
    "build:claude-extension": "node scripts/build-claude-extension.mjs",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "lint": "oxlint --type-aware --deny-warnings . && eslint . --max-warnings 0",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix . && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doc-lint": "node scripts/doc-lint.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "oxlint --type-aware --deny-warnings",
      "eslint --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1110.0",
    "@electric-sql/pglite": "^0.5.4",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "better-auth": "1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "envalid": "8.2.0",
    "express": "^4.19.2",
    "jose": "6.2.10",
    "jszip": "^3.10.2",
    "lucide-react": "^1.59.0",
    "nanoid": "^5.0.7",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "posthog-js": "^1.415.6",
    "puppeteer-core": "^25.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "0.34.3",
    "stripe": "21.0.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.9",
    "undici": "^8.10.2",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^8.2.2",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "mcp-remote": "0.15.1",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.6",
    "shadcn": "^4.19.0",
    "storybook": "10.6.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
