{
  "name": "cantelop-claude-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cantelop Edge API and Session actors hosting unmodified Claude Code",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "cantelop dev --container",
    "build": "node ../scripts/build-claude-runtime.mjs",
    "check": "tsc -p tsconfig.session.json",
    "test": "node --import tsx --test test/*.test.ts",
    "build:client": "node ../scripts/build-claude-client.mjs"
  },
  "dependencies": {
    "@cantelop/sdk": "1.0.0-alpha.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.10"
}
