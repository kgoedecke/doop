# Public identity verification configuration only. Never place a JWT signing
# private key or shared provider credential in Cantelop's App environment.
# Generate matching settings from the repository root (fresh checkout):
# bun run cantelop:setup --app my-doop-claude --local --prepare-only
# Choose your own app name; an already configured checkout must reuse its app.
# --prepare-only skips deployment and tunnels; no Cantelop login is needed.
# The private key stays in root .env; public settings are written to .env.setup
# in this directory. Use that generated file instead of these placeholders:
# bun run cantelop:dev --env-file .env.setup
# For Doop's local HTTP URL overrides, see the root .env.example and README.
AUTH_PUBLIC_JWK={"kty":"EC","crv":"P-256","x":"replace","y":"replace"}
AUTH_ISSUER=https://your-identity-provider.example
AUTH_AUDIENCE=cantelop-claude-api
