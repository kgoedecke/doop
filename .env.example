# Copy to .env and fill in what you need. Everything is optional in local
# development — features degrade gracefully with a clear message when their
# variable is unset.

# ---------------------------------------------------------------- database
# Unset = embedded Postgres (PGlite) persisted to ./data/pg — fine for local
# dev and single-instance self-hosting with a persistent volume. Set to a
# real Postgres in any serious deployment (same code path).
#DATABASE_URL=postgres://user:pass@host:5432/doop

# -------------------------------------------------------------------- auth
# Required in production (the server refuses to boot without it there).
# Long random string; sessions and OAuth tokens are signed with it.
#BETTER_AUTH_SECRET=
# Public origin of the deployment, e.g. https://doop.example.com — OAuth
# discovery/redirect URLs and absolute asset URLs are built on it.
#BETTER_AUTH_URL=
# Extra allowed origins for auth requests (comma-separated). Defaults to the
# localhost dev origins.
#TRUSTED_ORIGINS=
# Instance admins (comma-separated emails). These accounts get the admin role
# — at signup, and at boot for accounts that already exist — which unlocks
# /admin: every canvas and account on the instance, plus read-only "view as".
# Removing an email here does not demote anyone; that is an explicit action.
# REQUIRES SMTP in production: an address only identifies someone once they
# have verified it, and without a mailer signup is open, so a stranger could
# claim your address and the role with it. Production without SMTP promotes
# nobody and says so at boot; local development promotes without verifying.
#ADMIN_EMAILS=you@example.com

# Optional SSO against an external OIDC provider (Zitadel, Okta, Authentik,
# Keycloak, etc.), alongside email/password — not a replacement for it.
# Set all three of ISSUER/CLIENT_ID/CLIENT_SECRET together to enable; the
# server refuses to boot if only some are set (almost certainly a mistake).
# ISSUER is the provider's base URL — .well-known/openid-configuration is
# resolved from it. As of better-auth 1.6.26 this happens at sign-in time
# rather than at boot, but that's this version's behavior, not a guarantee.
#OIDC_ISSUER=https://idp.example.com
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
# Space- or comma-separated. Default: openid email profile
#OIDC_SCOPES=
# Shown on the login button ("Sign in with Zitadel"). Default: SSO
#OIDC_PROVIDER_NAME=Zitadel

# ------------------------------------------------------------------- email
# SMTP for verification and password-reset emails (works with any provider:
# Resend, Postmark, SES, a local relay). With SMTP_HOST set, new signups must
# verify their email before signing in. Unset = signup stays open and every
# email is printed to the server log instead — links included, so the flows
# still work in development.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
# true forces implicit TLS (also implied by port 465)
#SMTP_SECURE=
# NOTE ON PORTS: many hosts (Railway, Fly, most PaaS) block outbound 25/465/587
# to deter spam, and a blocked port shows up as a ~3 minute hang on any request
# that sends mail, not as an error. Resend also listens on 2465 and 2587 for
# exactly this reason — if signup or password reset hangs, try SMTP_PORT=2587.

# Set to false to let people sign in before verifying their email — fewer
# signups lost at the "check your inbox" step, at the cost of letting anyone
# hold an address they don't own. The verification email is still sent, so
# ADMIN_EMAILS (below) keeps working: promotion always requires a verified
# address, whatever this is set to.
#REQUIRE_EMAIL_VERIFICATION=false
#EMAIL_FROM="doop <no-reply@doop.example.com>"

# --------------------------------------------------------- resident agents
# What the built-in resident design team's FREE tier runs on (board cards,
# @mentions): anthropic (default) | azure. Each user's own connected account
# (ChatGPT or OpenAI key) always wins over this, whatever it is set to.
#DOOP_AGENT_PROVIDER=anthropic
# Anthropic API key — the free tier's key when DOOP_AGENT_PROVIDER=anthropic,
# and the guideline distiller's key either way. Unset = the team runs only for
# users who connected an account of their own; MCP agents work regardless.
#ANTHROPIC_API_KEY=
# The free tier's Azure OpenAI resource, used when DOOP_AGENT_PROVIDER=azure:
# the resource endpoint, one of its keys, and the deployment to run on.
#AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
#AZURE_OPENAI_API_KEY=
#AZURE_OPENAI_DEPLOYMENT=
# Only for resources that need a pinned api-version query parameter; the
# default v1 surface needs none.
#AZURE_OPENAI_API_VERSION=
# Reasoning effort for Azure runs. Unset = the parameter is not sent, which
# non-reasoning deployments require.
#AZURE_OPENAI_REASONING_EFFORT=
# Free-tier meter: resident tasks each account may start (default 5). Past it,
# the team keeps running on whatever model account the user connected (their
# ChatGPT subscription or OpenAI key). Users who connect their own agent via
# MCP are never metered.
#RESIDENT_TASK_LIMIT=5
# Model overrides for the resident team and the guideline distiller.
#DOOP_AGENT_MODEL=
#DOOP_DISTILL_MODEL=
# Default model tier for runs on a user's own account (ChatGPT or API key).
# Each user can pick another in Settings; this is only the starting point.
# gpt-5.6-sol (flagship) | gpt-5.6-terra (workhorse) | gpt-5.6-luna (cheap).
# gpt-5.4 and gpt-5.4-mini retire from ChatGPT-authed Codex on 2026-08-31.
#DOOP_AGENT_OPENAI_MODEL=gpt-5.6-terra
# Reasoning effort: none | low | medium | high | xhigh | max
#DOOP_AGENT_OPENAI_EFFORT=medium
# Set to 1 to hide the "connect ChatGPT" flow (OAuth against auth.openai.com),
# leaving only the plain OpenAI API-key path. Worth knowing: driving a ChatGPT
# subscription from a third-party server is outside OpenAI's terms and can get
# an account rate-limited — the API-key path is the supported alternative.
#CHATGPT_CONNECT_DISABLED=
# OAuth client for the ChatGPT flow. Defaults to the Codex CLI's public client,
# whose only registered redirect is the loopback URL below.
#CHATGPT_OAUTH_CLIENT_ID=
#CHATGPT_OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback
# When the browser is on this machine, Doop catches the OAuth redirect on this
# loopback port instead of asking the user to paste the URL back. Hosted
# deployments never see that redirect and use the device-code flow instead.
#CHATGPT_OAUTH_CALLBACK_PORT=1455
# auth.openai.com bot-filters a default Node fetch; this UA gets through.
#CHATGPT_AUTH_USER_AGENT=

# ------------------------------------------------------------ image search
# Stock photo search for design agents (the search_images tool, MCP and
# resident). Free key from https://www.pexels.com/api/ — unset disables photo
# search with a clear message to agents; icon search (search_icons) is keyless
# and always on.
#PEXELS_API_KEY=

# Optional upgrade for company-logo search (the search_logos tool). Keyless,
# search_logos serves open-source vector marks (well-known brands) plus
# DuckDuckGo favicons (any company, small raster). A free client id from
# https://developers.brandfetch.com/register upgrades results to high-res
# logos searchable by brand name.
#BRANDFETCH_CLIENT_ID=

# --------------------------------------------------- website acquisition
# Optional hosted browser for importing and viewing public websites. When set,
# Context.dev acquires the rendered HTML (including sites behind common bot
# challenges) and Doop renders that HTML locally for previews/editable frames.
# Unset = Doop navigates to websites directly with its local Chromium.
#CONTEXT_DEV_API_KEY=

# ----------------------------------------------------------- object storage
# Object storage for uploaded assets (the upload_asset MCP tool + browser
# paste/drop). Any S3-compatible store works; the names match what a Railway
# Bucket injects via variable references. Leave unset to store assets on
# local disk under ./data/assets (the development fallback).
#BUCKET=
#ACCESS_KEY_ID=
#SECRET_ACCESS_KEY=
#ENDPOINT=
#REGION=auto

# ------------------------------------------------------------- screenshots
# Frame screenshots render in a local Chrome/Chromium via puppeteer-core.
# Set only if it isn't auto-detected (the Docker image installs Chromium).
#CHROME_PATH=
# Set to 1 to pass --no-sandbox (needed in most containers; the Dockerfile does).
#CHROME_NO_SANDBOX=

# ------------------------------------------------- analytics (optional, OFF)
# PostHog product analytics + session replay. Entirely disabled unless
# VITE_POSTHOG_KEY is set at BUILD time (Vite inlines it — for Docker it must
# arrive as a build ARG, not a runtime var). The project key is a public,
# write-only token that ships in the JS bundle; it is not a secret.
#VITE_POSTHOG_KEY=
# Leave VITE_POSTHOG_HOST unset in normal use: the client then defaults to
# the same-origin /relay proxy (server/index.ts), which keeps analytics and
# session replay first-party. Only set this to point somewhere else.
#VITE_POSTHOG_HOST=
# Comma-separated email domains whose sessions are excluded from replay
# (your own team, so operator usage doesn't drown out real users).
#VITE_POSTHOG_INTERNAL_DOMAINS=
# Server-side overrides for where /relay forwards. Defaults are PostHog US
# cloud; set for EU cloud or self-hosted PostHog.
#POSTHOG_INGEST_HOST=https://us.i.posthog.com
#POSTHOG_ASSETS_HOST=https://us-assets.i.posthog.com
