{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "doop",
  "mainBinaryName": "doop-desktop",
  "version": "0.13.0",
  "identifier": "design.doop.desktop",
  "build": {
    "devUrl": "http://localhost:4300",
    "frontendDist": "https://doop.design"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "doop"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDMTFCREY0MzhGNkM1NjkKUldScHhmWTQ5TDBSdkJBV0Zaa3MvY01HWWRIaHhTd1NQazRlMERpUFBSLy95eU5EdEFCRmRPOE8K",
      "endpoints": [
        "https://doop.design/desktop/latest.json"
      ]
    }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "icon": [
      "../src-tauri/icons/32x32.png",
      "../src-tauri/icons/128x128.png",
      "../src-tauri/icons/128x128@2x.png",
      "../src-tauri/icons/icon.icns",
      "../src-tauri/icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "../src-tauri/dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
