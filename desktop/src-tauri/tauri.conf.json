{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "doop",
  "version": "0.4.0",
  "identifier": "design.doop.desktop",
  "build": {
    "devUrl": "http://localhost:4300",
    "frontendDist": "https://doop.design"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "doop"
        ]
      }
    }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
